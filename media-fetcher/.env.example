# ===== 必須 =====
# アクセス用トークン（16文字以上のランダムな文字列）。例: openssl rand -hex 24
APP_TOKEN=change-me

# ===== 自己診断（ヘルスチェック）に使う公開動画 =====
# 誰でも再生できて、消えにくい動画のURLを1本ずつ指定する（空なら、そのサイトの診断は行わない）
HEALTHCHECK_URL_YOUTUBE=
HEALTHCHECK_URL_NICONICO=

# ===== ログイン =====
# ログインモード: always（常に使う）/ on_failure（失敗時のみ使う）/ never（使わない）
# 管理画面で変更すると、そちらが優先される
LOGIN_MODE_YOUTUBE=on_failure
LOGIN_MODE_NICONICO=always
# ニコニコのID（メールアドレス）とパスワード。cookies.txt を使う場合は空でよい
NICONICO_USERNAME=
NICONICO_PASSWORD=

# ===== アクセス頻度 =====
# 同時実行数（1 または 2）。管理画面でも変更できる
MAX_CONCURRENCY=1
# ジョブとジョブの間のランダム待機（秒）
JOB_GAP_MIN_SECONDS=3
JOB_GAP_MAX_SECONDS=8
# 失敗時の自動再試行（指数バックオフ）。回数と、1回目の待ち時間（秒）
MAX_RETRIES=3
RETRY_BASE_SECONDS=30
# ボット判定・一時ブロック時の1回目の待ち時間（秒）。10分 → 20分 → 40分
BOT_RETRY_BASE_SECONDS=600

# ===== 更新 =====
# 起動時と毎日1回、yt-dlp を自動更新する
AUTO_UPDATE=true
# stable（安定版）/ nightly（毎日ビルド版）。管理画面でも切替できる
YTDLP_CHANNEL=stable
# 毎日の更新・自己診断・掃除を行う時刻（0〜23時）
DAILY_MAINTENANCE_HOUR=4

# ===== 所要時間の見積もりの初期値（実績がたまると自動で補正される）=====
# サーバーの下り回線速度の目安（Mbps）
DEFAULT_DOWNLOAD_MBPS=30
# サーバー → スマホ の転送速度の目安（Mbps）
DEFAULT_TRANSFER_MBPS=20
# メタデータ取得・JSチャレンジにかかる固定時間の目安（秒）
DEFAULT_OVERHEAD_SECONDS=8

# ===== その他 =====
# 完了ファイルを自動削除するまでの日数
RETENTION_DAYS=7
# プレイリスト全件取得の上限（最大20）
PLAYLIST_LIMIT=20
# コンテナ内のユーザーID・グループID（ホストで `id -u` `id -g` を実行して合わせる）
PUID=1000
PGID=1000
TZ=Asia/Tokyo
